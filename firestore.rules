rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return true;
    }

    function isAdmin() {
      return true;
    }

    // Validation for Cuenta
    function isValidCuenta(data) {
      return data.keys().hasAll(['id', 'consecutive', 'consecutiveFormatted', 'date', 'companyName', 'companyNit', 'driverName', 'driverId', 'vehiclePlate', 'totalAmount', 'status', 'userId']) &&
        data.keys().hasOnly(['id', 'consecutive', 'consecutiveFormatted', 'date', 'paymentDueDate', 'city', 'companyName', 'companyNit', 'driverName', 'driverId', 'vehiclePlate', 'driverPhone', 'services', 'observations', 'legalConcept', 'concept', 'paymentData', 'totalAmount', 'amountInWords', 'totalAmountInWords', 'signatureDataUrl', 'companyLogoUrl', 'status', 'createdAt', 'updatedAt', 'userId', 'userEmail', 'notes']) &&
        data.id is string && data.id.size() <= 128 &&
        data.consecutive is number && data.consecutive >= 0 &&
        data.consecutiveFormatted is string && data.consecutiveFormatted.size() <= 32 &&
        data.date is string && data.date.size() <= 32 &&
        (!('paymentDueDate' in data) || (data.paymentDueDate is string && data.paymentDueDate.size() <= 32)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
        data.companyName is string && data.companyName.size() <= 200 &&
        data.companyNit is string && data.companyNit.size() <= 100 &&
        data.driverName is string && data.driverName.size() <= 200 &&
        data.driverId is string && data.driverId.size() <= 50 &&
        data.vehiclePlate is string && data.vehiclePlate.size() <= 20 &&
        (!('driverPhone' in data) || (data.driverPhone is string && data.driverPhone.size() <= 30)) &&
        (!('services' in data) || (data.services is list && data.services.size() <= 50)) &&
        (!('observations' in data) || (data.observations is string && data.observations.size() <= 2000)) &&
        (!('legalConcept' in data) || (data.legalConcept is string && data.legalConcept.size() <= 2000)) &&
        (!('concept' in data) || (data.concept is string && data.concept.size() <= 2000)) &&
        (!('paymentData' in data) || (data.paymentData is map)) &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        (!('amountInWords' in data) || (data.amountInWords is string && data.amountInWords.size() <= 500)) &&
        (!('totalAmountInWords' in data) || (data.totalAmountInWords is string && data.totalAmountInWords.size() <= 500)) &&
        (!('signatureDataUrl' in data) || (data.signatureDataUrl is string && data.signatureDataUrl.size() <= 50000)) &&
        (!('companyLogoUrl' in data) || (data.companyLogoUrl is string && data.companyLogoUrl.size() <= 2000)) &&
        data.status in ['emitida', 'radicada', 'pagada', 'anulada'] &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        data.userId is string && data.userId.size() <= 128 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 128)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    // Validation for Driver Profile
    function isValidDriver(data) {
      return data.keys().hasAll(['id', 'plate', 'driverName', 'idNumber', 'userId']) &&
        data.keys().hasOnly(['id', 'plate', 'driverName', 'idNumber', 'phone', 'paymentData', 'frequentClients', 'totalAccountsGenerated', 'lastUsedAt', 'createdAt', 'updatedAt', 'userId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.plate is string && data.plate.size() <= 20 &&
        data.driverName is string && data.driverName.size() <= 200 &&
        data.idNumber is string && data.idNumber.size() <= 50 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('paymentData' in data) || (data.paymentData is map)) &&
        (!('frequentClients' in data) || (data.frequentClients is list && data.frequentClients.size() <= 30)) &&
        (!('totalAccountsGenerated' in data) || (data.totalAccountsGenerated is number)) &&
        (!('lastUsedAt' in data) || (data.lastUsedAt is string && data.lastUsedAt.size() <= 64)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        data.userId is string && data.userId.size() <= 128;
    }

    // Validation for Settings
    function isValidSettings(data) {
      return data.keys().hasAll(['id', 'prefix', 'nextConsecutive', 'companyName', 'companyNit']) &&
        data.keys().hasOnly(['id', 'prefix', 'nextConsecutive', 'companyName', 'companyNit', 'companyAddress', 'companyPhone', 'companyEmail', 'defaultCity', 'defaultConcept', 'companyLogoUrl', 'companySlogan', 'updatedAt', 'updatedBy']) &&
        data.id is string && data.id.size() <= 64 &&
        data.prefix is string && data.prefix.size() <= 20 &&
        data.nextConsecutive is number && data.nextConsecutive >= 0 &&
        data.companyName is string && data.companyName.size() <= 200 &&
        data.companyNit is string && data.companyNit.size() <= 100 &&
        (!('companyAddress' in data) || (data.companyAddress is string && data.companyAddress.size() <= 200)) &&
        (!('companyPhone' in data) || (data.companyPhone is string && data.companyPhone.size() <= 50)) &&
        (!('companyEmail' in data) || (data.companyEmail is string && data.companyEmail.size() <= 120)) &&
        (!('defaultCity' in data) || (data.defaultCity is string && data.defaultCity.size() <= 100)) &&
        (!('defaultConcept' in data) || (data.defaultConcept is string && data.defaultConcept.size() <= 2000)) &&
        (!('companyLogoUrl' in data) || (data.companyLogoUrl is string && data.companyLogoUrl.size() <= 2000)) &&
        (!('companySlogan' in data) || (data.companySlogan is string && data.companySlogan.size() <= 200)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // Cuentas Collection
    match /cuentas/{cuentaId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isValidId(cuentaId) &&
        isSignedIn() &&
        isValidCuenta(incoming()) &&
        (incoming().userId == request.auth.uid || isAdmin());

      allow update: if isValidId(cuentaId) &&
        isSignedIn() &&
        isValidCuenta(incoming()) &&
        incoming().userId == existing().userId &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            // Action 1: Status change
            (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            // Action 2: Standard editable fields (cannot alter if already in terminal state 'anulada')
            (
              existing().status != 'anulada' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'consecutive', 'consecutiveFormatted', 'date', 'paymentDueDate', 'city',
                'companyName', 'companyNit', 'driverName', 'driverId', 'vehiclePlate',
                'driverPhone', 'services', 'observations', 'legalConcept', 'concept', 'paymentData',
                'totalAmount', 'amountInWords', 'totalAmountInWords', 'signatureDataUrl', 'companyLogoUrl', 'status', 'updatedAt', 'notes'
              ])
            )
          )
        );

      allow delete: if isValidId(cuentaId) &&
        isSignedIn() &&
        (isAdmin() || (resource.data.userId == request.auth.uid && resource.data.status != 'pagada'));
    }

    // Drivers Directory
    match /drivers/{driverId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isValidId(driverId) &&
        isSignedIn() &&
        isValidDriver(incoming()) &&
        (incoming().userId == request.auth.uid || isAdmin());

      allow update: if isValidId(driverId) &&
        isSignedIn() &&
        isValidDriver(incoming()) &&
        incoming().userId == existing().userId &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'plate', 'driverName', 'idNumber', 'phone', 'paymentData',
              'frequentClients', 'totalAccountsGenerated', 'lastUsedAt', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(driverId) &&
        isSignedIn() &&
        (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // App Settings (Consecutive & Company Information)
    match /settings/{settingId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isValidId(settingId) &&
        isSignedIn() &&
        isValidSettings(incoming());

      allow update: if isValidId(settingId) &&
        isSignedIn() &&
        isValidSettings(incoming()) &&
        (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'prefix', 'nextConsecutive', 'companyName', 'companyNit',
            'companyAddress', 'companyPhone', 'companyEmail', 'defaultCity',
            'defaultConcept', 'companyLogoUrl', 'companySlogan', 'updatedAt', 'updatedBy'
          ])
        );

      allow delete: if isAdmin();
    }
  }
}
