{
  "entities": {
    "Cuenta": {
      "title": "Cuenta",
      "description": "Cuenta de Cobro para Transportes Ravel",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "ID único de la cuenta de cobro"
        },
        "consecutive": {
          "type": "number",
          "description": "Número consecutivo numérico"
        },
        "consecutiveFormatted": {
          "type": "string",
          "maxLength": 32,
          "description": "Consecutivo formateado como CC-0100"
        },
        "date": {
          "type": "string",
          "maxLength": 32,
          "description": "Fecha de emisión en formato YYYY-MM-DD"
        },
        "paymentDueDate": {
          "type": "string",
          "maxLength": 32,
          "description": "Fecha límite de pago en formato YYYY-MM-DD"
        },
        "city": {
          "type": "string",
          "maxLength": 100,
          "description": "Ciudad de expedición"
        },
        "companyName": {
          "type": "string",
          "maxLength": 200,
          "description": "Razón social de la empresa cliente"
        },
        "companyNit": {
          "type": "string",
          "maxLength": 100,
          "description": "NIT o identificación tributaria de la empresa cliente"
        },
        "driverName": {
          "type": "string",
          "maxLength": 200,
          "description": "Nombre completo del conductor o transportador"
        },
        "driverId": {
          "type": "string",
          "maxLength": 50,
          "description": "Cédula o documento del conductor"
        },
        "vehiclePlate": {
          "type": "string",
          "maxLength": 20,
          "description": "Placa del vehículo"
        },
        "driverPhone": {
          "type": "string",
          "maxLength": 30,
          "description": "Teléfono de contacto del conductor"
        },
        "services": {
          "type": "array",
          "description": "Lista de servicios de transporte prestados"
        },
        "observations": {
          "type": "string",
          "maxLength": 2000,
          "description": "Observaciones adicionales"
        },
        "legalConcept": {
          "type": "string",
          "maxLength": 2000,
          "description": "Concepto legal de la cuenta de cobro"
        },
        "paymentData": {
          "type": "object",
          "description": "Datos bancarios para consignación"
        },
        "totalAmount": {
          "type": "number",
          "description": "Valor total de la cuenta en pesos colombianos"
        },
        "amountInWords": {
          "type": "string",
          "maxLength": 500,
          "description": "Valor total expresado en letras"
        },
        "signatureDataUrl": {
          "type": "string",
          "maxLength": 50000,
          "description": "Firma digitalizada en base64"
        },
        "companyLogoUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "URL del logotipo corporativo"
        },
        "status": {
          "type": "string",
          "enum": ["emitida", "radicada", "pagada", "anulada"],
          "description": "Estado actual de la cuenta"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Fecha y hora de creación"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Fecha y hora de última modificación"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID del usuario propietario o creador"
        },
        "userEmail": {
          "type": "string",
          "maxLength": 128,
          "description": "Correo del creador"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Notas internas"
        }
      },
      "required": ["id", "consecutive", "consecutiveFormatted", "date", "companyName", "companyNit", "driverName", "driverId", "vehiclePlate", "totalAmount", "status", "userId"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Perfil de conductor y vehículo frecuente",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "ID del perfil de conductor"
        },
        "plate": {
          "type": "string",
          "maxLength": 20,
          "description": "Placa del vehículo"
        },
        "driverName": {
          "type": "string",
          "maxLength": 200,
          "description": "Nombre del conductor"
        },
        "idNumber": {
          "type": "string",
          "maxLength": 50,
          "description": "Número de cédula"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Número de teléfono"
        },
        "paymentData": {
          "type": "object",
          "description": "Datos bancarios guardados"
        },
        "frequentClients": {
          "type": "array",
          "description": "Clientes o rutas frecuentes"
        },
        "totalAccountsGenerated": {
          "type": "number",
          "description": "Contador de cuentas generadas"
        },
        "lastUsedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Última fecha de uso"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Fecha de registro"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Fecha de actualización"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID del usuario creador"
        }
      },
      "required": ["id", "plate", "driverName", "idNumber", "userId"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Configuración global de la empresa y numeración consecutiva",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "description": "ID del documento de configuración"
        },
        "prefix": {
          "type": "string",
          "maxLength": 20,
          "description": "Prefijo consecutivo, ej. CC-"
        },
        "nextConsecutive": {
          "type": "number",
          "description": "Siguiente número consecutivo"
        },
        "companyName": {
          "type": "string",
          "maxLength": 200,
          "description": "Nombre de Transportes Ravel"
        },
        "companyNit": {
          "type": "string",
          "maxLength": 100,
          "description": "NIT de la empresa"
        },
        "companyAddress": {
          "type": "string",
          "maxLength": 200,
          "description": "Dirección física de la empresa"
        },
        "companyPhone": {
          "type": "string",
          "maxLength": 50,
          "description": "Teléfono corporativo"
        },
        "companyEmail": {
          "type": "string",
          "maxLength": 120,
          "description": "Correo corporativo"
        },
        "defaultCity": {
          "type": "string",
          "maxLength": 100,
          "description": "Ciudad por defecto"
        },
        "defaultConcept": {
          "type": "string",
          "maxLength": 2000,
          "description": "Concepto estándar de cobro"
        },
        "companyLogoUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "URL del logo de empresa"
        },
        "companySlogan": {
          "type": "string",
          "maxLength": 200,
          "description": "Eslogan corporativo"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Fecha de última actualización"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128,
          "description": "ID del usuario que modificó los ajustes"
        }
      },
      "required": ["id", "prefix", "nextConsecutive", "companyName", "companyNit"]
    }
  },
  "firestore": {
    "/cuentas/{cuentaId}": {
      "schema": "Cuenta",
      "description": "Cuentas de cobro almacenadas en la nube"
    },
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Directorio de conductores y vehículos sincronizados"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Ajustes de numeración y datos corporativos"
    }
  }
}
